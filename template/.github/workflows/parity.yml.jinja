name: Parity

# Release parity: starts the last released image of this server from GHCR and
# a candidate built from this change, side by side, and compares what an MCP
# client sees from each: the tool list, every tool's full description and
# input schema, and the answers to the golden calls in parity/golden.yaml.
# Any difference fails unless parity/expected.yaml declares it with a reason.
#
# The runner lives in pete-mcp-template and is pinned to the template commit
# this repo was generated from. `copier update` moves the pin.

on:
  pull_request:
  workflow_dispatch:
  # Run before a release, and publish only when it passes. In release.yml:
  #
  #   jobs:
  #     parity:
  #       uses: ./.github/workflows/parity.yml
  #       permissions:
  #         contents: read
  #         packages: read
  #       with:
  #         release-version: {% raw %}${{ github.ref_name }}{% endraw %}
  #     publish:
  #       needs: parity
  #       ...
  workflow_call:
    inputs:
      release-version:
        description: The version being released; the baseline is the newest release below it
        type: string
        default: ""

permissions:
  contents: read

jobs:
  parity:
    name: Release parity
    permissions:
      contents: read
      packages: read
    uses: pete-builds/pete-mcp-template/.github/workflows/mcp-parity.yml@{{ _copier_conf.vcs_ref_hash or "UNPINNED-render-the-template-from-git" }}
    with:
      image: ghcr.io/{{ github_org | lower }}/{{ repo_name | lower }}
      port: {{ default_port }}
      env-file: parity/parity.env
      release-version: {% raw %}${{ inputs.release-version }}{% endraw %}
