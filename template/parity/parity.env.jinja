# Dummy environment for the release parity check. The SAME file is given to the
# last released image, the candidate and the parity client.
#
# Never put a real secret here: this file is committed. Use placeholder values
# that let the server start. Do not set MCP_HOST or MCP_PORT unless your deploy
# does: the check exists to catch a server whose own defaults stop answering
# other containers.

# The server refuses to start streamable-http without a token, and the parity
# client sends this one as its bearer token.
MCP_AUTH_TOKEN=parity-dummy-token-not-a-secret
{%- if default_transport == "stdio" %}

# This server defaults to stdio; the check talks to it over streamable-http.
MCP_TRANSPORT=streamable-http
{%- endif %}

# Add your server's own variables with dummy values, e.g.:
# WEATHER_API_KEY=parity-dummy
